# === Detective AI Configuration ===

# Groq API (free tier: https://console.groq.com) — required for LLM agent mode.
# Leave empty to use the deterministic offline pipeline only.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Database. PostgreSQL + pgvector in production:
#   DATABASE_URL=postgresql://detective:detective123@localhost:5432/detective_ai
# If PostgreSQL is unreachable the app automatically falls back to SQLite
# (data/detective_ai.db). You can also set it explicitly:
#   DATABASE_URL=sqlite:///data/detective_ai.db
DATABASE_URL=postgresql://detective:detective123@localhost:5432/detective_ai

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# CV Pipeline (requires: pip install "detective-ai[cv]")
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
REID_BATCH_SIZE=4
FRAME_EXTRACTION_FPS=2

# Agent Settings
MAX_INVESTIGATION_ROUNDS=3
CONFIDENCE_THRESHOLD=0.6
GROQ_RATE_LIMIT_RPM=28

# Embeddings (requires: pip install "detective-ai[embeddings]")
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384