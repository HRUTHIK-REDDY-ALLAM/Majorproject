# === Detective AI Configuration ===

# Groq API (free tier: https://console.groq.com) — required for LLM agent mode.
# Leave empty to use the deterministic offline pipeline only.
GROQ_API_KEY=
# Model for the reasoning agents. Groq's daily token budget is PER MODEL and
# PER ORGANISATION — a new API key on the same account shares the same quota.
# Keep this different from VISION_MODEL below, or video ingestion and the
# investigation compete for one budget and whichever runs second fails.
GROQ_MODEL=openai/gpt-oss-120b

# Database. PostgreSQL + pgvector in production:
#   DATABASE_URL=postgresql://detective:detective123@localhost:5432/detective_ai
# If PostgreSQL is unreachable the app automatically falls back to SQLite
# (data/detective_ai.db). You can also set it explicitly:
#   DATABASE_URL=sqlite:///data/detective_ai.db
DATABASE_URL=postgresql://detective:detective123@localhost:5432/detective_ai

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# CV Pipeline. OpenCV + the bundled MobileNet-SSD detector ship by default;
# install "detective-ai[cv]" only to upgrade detection to YOLOv8.
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
REID_BATCH_SIZE=4
FRAME_EXTRACTION_FPS=2

# LLM video understanding. The recording is split into consecutive time
# windows covering its whole duration; each window is rendered as one
# labelled contact sheet and read by a vision model, which then decides how
# many distinct people appear and what they do. This is the primary source
# of evidence — object detection is only a corroborating signal, because it
# recounts the same person whenever tracking breaks.
# VISION_MODEL must be a vision-capable model on your Groq account.
VISION_ENABLED=true
VISION_MODEL=qwen/qwen3.8-27b
# Target length of each analysed window, in seconds.
VIDEO_SEGMENT_SECONDS=4
# Cap on windows per video, so a long recording stays inside the API's
# per-minute token budget. Longer videos get proportionally longer windows.
VIDEO_MAX_SEGMENTS=12
# Frames tiled into each window's contact sheet.
VIDEO_FRAMES_PER_SEGMENT=6

# Agent Settings
MAX_INVESTIGATION_ROUNDS=3
CONFIDENCE_THRESHOLD=0.6
GROQ_RATE_LIMIT_RPM=28

# Embeddings (requires: pip install "detective-ai[embeddings]")
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384